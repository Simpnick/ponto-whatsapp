{
  "manifest_version": 3,
  "name": "Ponto para WhatsApp Web",
  "version": "0.1.0",
  "description": "Personalize mensagens e organize anexos para os seus contatos.",
  "minimum_chrome_version": "140",
  "permissions": ["activeTab", "scripting"],
  "action": { "default_title": "Abrir Ponto no WhatsApp Web" },
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } }
  }
}
